# Raseed Traders - Environment Configuration Template
# Duplicate this file as .env.local for local development, or .env.production for production deployment

# 1. Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anon (Public) API Key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Application Login Password Gate
VITE_APP_PASSWORD=your-secure-password
